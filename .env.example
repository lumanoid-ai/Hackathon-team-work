# ================== LLM ==================
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# ================== DB ==================
# Local dev (kuch install nahi karna parta):
DATABASE_URL=sqlite:///./data/hr.db
# Production / Supabase:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/postgres

# ================== EMAIL (Gmail App Password free hai) ==================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourcompany@gmail.com
SMTP_PASSWORD=your_16_char_app_password
MAIL_FROM_NAME=Acme Talent Team
HR_INBOX=hr@yourcompany.com

# ================== Business rules ==================
COMPANY_NAME=Luminoid AI
SHORTLIST_THRESHOLD=75
HOLD_THRESHOLD=55
AUTO_SCHEDULE_INTERVIEW=true
ADMIN_API_KEY=change-me-admin-key

# ================== Job board sync ==================
JOB_SYNC_ENABLED=true
JOB_SYNC_QUERIES=python developer,data analyst,backend engineer
